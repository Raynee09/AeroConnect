<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>AeroConnect - Airline Reservation &amp; Management System</display-name>

    <!-- ==================== Context Parameters ==================== -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>AeroConnect</param-value>
    </context-param>

    <!-- ==================== Filters ==================== -->

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.aeroconnect.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/passenger/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Character Encoding Filter -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.aeroconnect.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================== Servlets ==================== -->

    <!-- Home Servlet -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlet (login, logout, register) -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Flight Search Servlet -->
    <servlet>
        <servlet-name>FlightSearchServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.FlightSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FlightSearchServlet</servlet-name>
        <url-pattern>/flights/search</url-pattern>
    </servlet-mapping>

    <!-- Passenger Servlets -->
    <servlet>
        <servlet-name>PassengerDashboardServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.passenger.PassengerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PassengerDashboardServlet</servlet-name>
        <url-pattern>/passenger/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.passenger.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/passenger/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.passenger.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/passenger/profile</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminFlightServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.admin.AdminFlightServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminFlightServlet</servlet-name>
        <url-pattern>/admin/flights</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPassengerServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.admin.AdminPassengerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPassengerServlet</servlet-name>
        <url-pattern>/admin/passengers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminBookingServlet</servlet-name>
        <servlet-class>com.aeroconnect.controller.admin.AdminBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminBookingServlet</servlet-name>
        <url-pattern>/admin/bookings</url-pattern>
    </servlet-mapping>

    <!-- ==================== Session Config ==================== -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- ==================== Welcome File ==================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ==================== Error Pages ==================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/public/error404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/public/error500.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/public/error403.jsp</location>
    </error-page>

</web-app>
